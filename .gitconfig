# This file is not symlinked to ~/.gitconfig since the original file also contains a signing key to 1Password.

[user]
    email = abhayvashokan@gmail.com
    name = Abhay V Ashokan

[core]
	pager = delta
    editor = nvim
    fsmonitor = true
    untrackedcache = true
[interactive]
	diffFilter = delta --color-only
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[branch]
	autosetuprebase = always
	sort = -committerdate
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[color]
	ui = true
[safe]
	directory = *
	
# Delta
[interactive]
[delta]
	navigate = true
	side-by-side = true
	features = side-by-side line-numbers decorations
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[column]
	ui = auto
[fetch]
	writeCommitGraph = true
[maintenance]
	repo = /Users/abhayvashokan/gdk
	repo = /Users/abhayvashokan/gdk/gitlab
	repo = /Users/abhayvashokan/Documents/work/gdk
	repo = /Users/abhayvashokan/Documents/work/gdk/gitlab
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
